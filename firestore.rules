rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUserProfilePath() {
      return /databases/$(database)/documents/user_profiles/$(request.auth.uid);
    }

    function isStaff() {
      return signedIn() &&
        exists(currentUserProfilePath()) &&
        get(currentUserProfilePath()).data.role == 'Staff';
    }

    function followsUser(userId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/friendships/$(friendshipIdFor(request.auth.uid, userId)));
    }

    function friendshipIdFor(uidA, uidB) {
      return uidA < uidB
        ? uidA + "_" + uidB
        : uidB + "_" + uidA;
    }

    function classReservationFieldsOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'filled',
        'registeredCount',
        'status',
        'reservedMats',
        'standbyQueue',
        'roster',
      ]);
    }

    function staffAttendanceProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'achievements',
        'category_attendance',
      ]);
    }

    function staffAttendanceRegistrationFieldsOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'attendedAt',
        'noShowAt',
      ]);
    }

    match /user_profiles/{userId} {
      allow read: if signedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) ||
        (isStaff() && staffAttendanceProfileFieldsOnly());

      match /friends/{friendId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isOwner(userId) ||
          (signedIn() &&
            request.resource.data.uid is string &&
            request.resource.data.uid == request.auth.uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if signedIn();
        allow update, delete: if isOwner(userId);
      }

      match /registrations/{classId} {
        allow read: if isOwner(userId) || isStaff() || followsUser(userId);
        allow create, delete: if isOwner(userId);
        allow update: if isOwner(userId) ||
          (isStaff() && staffAttendanceRegistrationFieldsOnly());
      }
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (signedIn() && classReservationFieldsOnly());

      match /registrations/{userId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(userId);
        allow update: if isStaff() && staffAttendanceRegistrationFieldsOnly();
      }

      match /standby_queue/{userId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.from_uid == request.auth.uid ||
          resource.data.to_uid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.from_uid == request.auth.uid &&
        request.resource.data.to_uid is string &&
        request.resource.data.status == 'pending';
      allow update: if signedIn() &&
        (resource.data.from_uid == request.auth.uid ||
          resource.data.to_uid == request.auth.uid);
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;
    }
  }
}
