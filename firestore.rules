rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn() && currentUserProfile().data.role == 'Staff';
    }

    function classReservationFieldsOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'filled',
        'registeredCount',
        'status',
        'reservedMats',
        'standbyCount',
        'standbyQueue',
        'roster',
      ]);
    }

    function ownerNoShowRegistrationUpdate(userId) {
      return isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'noShowAt',
        ]) &&
        request.resource.data.status == 'NO-SHOW';
    }

    match /user_profiles/{userId} {
      allow read: if signedIn();
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId) || isStaff();

      match /friends/{friendId} {
        allow read, update: if isOwner(userId);
        allow delete: if isOwner(userId) ||
          (signedIn() &&
            ((resource.data.uid is string &&
              resource.data.uid == request.auth.uid) ||
             friendId == request.auth.uid));
        allow create: if isOwner(userId) ||
          (signedIn() &&
            request.resource.data.uid is string &&
            request.resource.data.uid == request.auth.uid);
      }

      match /sent_friend_requests/{requestUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId) ||
          (signedIn() && requestUid == request.auth.uid);
        allow update: if false;
      }

      match /received_friend_requests/{requestUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) ||
          (signedIn() &&
            request.resource.data.uid is string &&
            request.resource.data.uid == request.auth.uid);
        allow delete: if isOwner(userId) || requestUid == request.auth.uid;
        allow update: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if signedIn();
        allow update: if isOwner(userId) || isStaff();
        allow delete: if isOwner(userId);
      }

      match /registrations/{classId} {
        allow read: if isOwner(userId) || isStaff();
        allow create, delete: if isOwner(userId);
        allow update: if isOwner(userId) || isStaff();
      }
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (signedIn() && classReservationFieldsOnly());

      match /registrations/{userId} {
        allow read: if signedIn();
        allow create: if isOwner(userId) || isStaff();
        allow delete: if isOwner(userId);
        allow update: if isStaff() || ownerNoShowRegistrationUpdate(userId);
      }

      match /standby_queue/{userId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      match /pending_group_invites/{inviteeUid} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if isStaff() || isOwner(inviteeUid);
        allow delete: if signedIn();
      }
    }
  }
}
