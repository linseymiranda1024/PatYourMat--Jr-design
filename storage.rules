rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaff() {
      let profilePath = ['databases', '(default)', 'documents', 'user_profiles', request.auth.uid];
      return isSignedIn() && 
             firestore.exists(profilePath) &&
             (firestore.get(profilePath).data.role == 'Staff' ||
              ('allow_class_creation' in firestore.get(profilePath).data &&
               firestore.get(profilePath).data.allow_class_creation == true));
    }

    match /users/{userId}/profile_picture/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if isOwner(userId);
    }

    match /classes/images/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
