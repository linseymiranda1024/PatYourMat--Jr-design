rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaff() {
      return isSignedIn() && 
             firestore.exists(/databases/(default)/documents/user_profiles/$(request.auth.uid)) &&
             (firestore.get(/databases/(default)/documents/user_profiles/$(request.auth.uid)).data.role == 'Staff' ||
              firestore.get(/databases/(default)/documents/user_profiles/$(request.auth.uid)).data.get('allow_class_creation', false) == true);
    }

    match /users/{userId}/profile_picture/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if isOwner(userId);
    }

    match /classes/images/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
